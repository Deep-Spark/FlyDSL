# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=180
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    build-essential \
    cmake \
    ninja-build \
    patchelf \
    git \
    curl \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "${VIRTUAL_ENV}"

RUN set -eux; \
    retry() { \
      n=0; \
      until [ "$n" -ge 5 ]; do \
        "$@" && break; \
        n=$((n+1)); \
        echo "retry $n/5: $*"; \
        sleep $((5*n)); \
      done; \
      [ "$n" -lt 5 ]; \
    }; \
    retry pip install --upgrade pip --retries 10 --timeout 180; \
    retry pip install --no-cache-dir --retries 10 --timeout 180 \
      nanobind \
      pybind11 \
      "numpy<2" \
      pytest

ARG COREX_TORCH_WHEEL_MD5
ARG COREX_TORCH_WHEEL_NAME
ARG SKIP_COREX_TORCH_INSTALL=0

RUN --mount=type=bind,source=.github/docker/corex_torch.whl,target=/tmp/corex_torch.whl,readonly \
    set -eux; \
    if [ "${SKIP_COREX_TORCH_INSTALL}" = "1" ]; then \
      echo "skip CoreX torch install and reuse torch from base image"; \
    else \
      test -n "${COREX_TORCH_WHEEL_MD5}"; \
      test -n "${COREX_TORCH_WHEEL_NAME}"; \
      echo "${COREX_TORCH_WHEEL_MD5}  /tmp/corex_torch.whl" | md5sum -c -; \
      install -m 0644 /tmp/corex_torch.whl "/tmp/${COREX_TORCH_WHEEL_NAME}"; \
      pip install --no-cache-dir --retries 10 --timeout 180 "/tmp/${COREX_TORCH_WHEEL_NAME}"; \
      rm -f "/tmp/${COREX_TORCH_WHEEL_NAME}"; \
    fi

WORKDIR /workspace
